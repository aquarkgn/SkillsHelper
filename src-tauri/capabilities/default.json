{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "SkillHelper 桌面端最小权限集",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/skillhelper-core",
          "sidecar": true,
          "args": [
            {
              "validator": ".*"
            }
          ]
        }
      ]
    }
  ]
}
